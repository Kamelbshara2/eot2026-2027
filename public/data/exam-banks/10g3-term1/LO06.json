      "instruction": "Which option is the complete factorisation of the expression?",
      "stem": "Which option is the complete factorisation of the expression? 5 x^{2} + 34 x + 24",
      "math_latex": "5 x^{2} + 34 x + 24",
      "marks": null,
      "options": [
        {
          "id": "A",
          "text": "\\left(6 - x\\right) \\left(5 x + 4\\right)",
          "math_latex": "\\left(6 - x\\right) \\left(5 x + 4\\right)",
          "misconception": "Reverse a sign inside a factor."
        },
        {
          "id": "B",
          "text": "\\left(x + 6\\right) \\left(5 x + 4\\right)",
          "math_latex": "\\left(x + 6\\right) \\left(5 x + 4\\right)",
          "misconception": null
        },
        {
          "id": "C",
          "text": "\\left(x - 6\\right) \\left(5 x + 4\\right)",
          "math_latex": "\\left(x - 6\\right) \\left(5 x + 4\\right)",
          "misconception": "Reverse a sign inside a factor."
        },
        {
          "id": "D",
          "text": "\\left(4 - 5 x\\right) \\left(x + 6\\right)",
          "math_latex": "\\left(4 - 5 x\\right) \\left(x + 6\\right)",
          "misconception": "Reverse a sign inside a factor."
        }
      ],
      "answer": {
        "correct_option_id": "B",
        "correct_option_text": "\\left(x + 6\\right) \\left(5 x + 4\\right)",
        "explanation": "Split the middle term and factor by grouping: (x + 6)·(5·x + 4)."
      },

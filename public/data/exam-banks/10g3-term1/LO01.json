      "id": "G10G-Q01-MCQ-01",
      "learning_outcome_id": "LO01",
      "type": "mcq",
      "display_number": "1.1",
      "instruction": "Which option gives the product?",
      "stem": "Which option gives the product? \\left(c + 3\\right) \\left(3 c - 5\\right)",
      "math_latex": "\\left(c + 3\\right) \\left(3 c - 5\\right)",
      "marks": null,
      "options": [
        {
          "id": "A",
          "text": "3 c^{2} + 4 c",
          "math_latex": "3 c^{2} + 4 c",
          "misconception": "Omit a term when distributing or combining like terms."
        },
        {
          "id": "B",
          "text": "3 c^{2} + 4 c + 15",
          "math_latex": "3 c^{2} + 4 c + 15",
          "misconception": "Reverse the sign of a term."
        },
        {
          "id": "C",
          "text": "\\left(3 c^{2} + 4 c\\right) - 15",
          "math_latex": "\\left(3 c^{2} + 4 c\\right) - 15",
          "misconception": null
        },
        {
          "id": "D",
          "text": "4 c - 15",
          "math_latex": "4 c - 15",
          "misconception": "Omit a term when distributing or combining like terms."
        }
      ],
      "answer": {
        "correct_option_id": "C",
        "correct_option_text": "\\left(3 c^{2} + 4 c\\right) - 15",
        "explanation": "Use FOIL and combine like terms: 3·c² + 4·c - 15."
      },

      "type": "mcq",
      "display_number": "15.3",
      "instruction": "For x²−5x−7=0, which comparison of completing the square, graphing and factoring is correct?",
      "stem": "For x²−5x−7=0, which comparison of completing the square, graphing and factoring is correct?",
      "math_latex": "",
      "marks": null,
      "options": [
        {
          "id": "A",
          "text": "Graphing always gives exact irrational roots."
        },
        {
          "id": "B",
          "text": "Completing the square gives only one root."
        },
        {
          "id": "C",
          "text": "Completing the square gives exact irrational roots; graphing estimates them; integer factoring does not work."
        },
        {
          "id": "D",
          "text": "Integer factoring gives roots 7 and −1."
        }
      ],
      "answer": {
        "correct_option_id": "C",
        "correct_option_text": "Completing the square gives exact irrational roots; graphing estimates them; integer factoring does not work.",
        "explanation": "The discriminant is 53, not a perfect square. Completing the square gives (5±√53)/2; graphing estimates the two intercepts."
      },

      "type": "mcq",
      "display_number": "15.1",
      "instruction": "Which expression does not belong because it is not a perfect square trinomial?",
      "stem": "Which expression does not belong because it is not a perfect square trinomial?",
      "math_latex": "",
      "marks": null,
      "options": [
        {
          "id": "A",
          "text": "n^2+n+\\frac34",
          "math_latex": "n^2+n+\\frac34"
        },
        {
          "id": "B",
          "text": "n^2-n+\\frac14",
          "math_latex": "n^2-n+\\frac14"
        },
        {
          "id": "C",
          "text": "n^2-\\frac23n+\\frac19",
          "math_latex": "n^2-\\frac23n+\\frac19"
        },
        {
          "id": "D",
          "text": "n^2+\\frac13n+\\frac1{36}",
          "math_latex": "n^2+\\frac13n+\\frac1{36}"
        }
      ],
      "answer": {
        "correct_option_id": "A",
        "correct_option_text": "n^2+n+\\frac34",
        "explanation": "The first, third and fourth forms equal (n−½)², (n−⅓)² and (n+⅙)². For n²+n+c, c must be ¼, not ¾."
      },

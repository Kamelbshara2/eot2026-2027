      "type": "mcq",
      "display_number": "4.1",
      "instruction": "Which option is the complete factorisation of the expression?",
      "stem": "Which option is the complete factorisation of the expression? 16 t - 40 y",
      "math_latex": "16 t - 40 y",
      "marks": null,
      "options": [
        {
          "id": "A",
          "text": "- 16 t - 40 y",
          "math_latex": "- 16 t - 40 y",
          "misconception": "Reverse a sign inside a factor."
        },
        {
          "id": "B",
          "text": "16 t + 40 y",
          "math_latex": "16 t + 40 y",
          "misconception": "Reverse a sign inside a factor."
        },
        {
          "id": "C",
          "text": "- 2 t + 5 y",
          "math_latex": "- 2 t + 5 y",
          "misconception": "Omit the greatest common numerical factor."
        },
        {
          "id": "D",
          "text": "- 8 \\left(- 2 t + 5 y\\right)",
          "math_latex": "- 8 \\left(- 2 t + 5 y\\right)",
          "misconception": null
        }
      ],
      "answer": {
        "correct_option_id": "D",
        "correct_option_text": "- 8 \\left(- 2 t + 5 y\\right)",
        "explanation": "Take out the GCF: -8·(-2·t + 5·y). Expanding restores the original polynomial."
      },

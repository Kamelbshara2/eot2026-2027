      "type": "mcq",
      "learning_outcome_id": "LO13",
      "origin": "parallel_practice",
      "stem": "D lies on AB and E on AC. AD = 4, DB = 6, AE = 6, and EC = 9. Which conclusion follows?",
      "diagram_asset_ids": [],
      "options": [
        {
          "id": "A",
          "text": "DE = BC"
        },
        {
          "id": "B",
          "text": "DE ∥ BC"
        },
        {
          "id": "C",
          "text": "DE ⟂ BC"
        },
        {
          "id": "D",
          "text": "AB = AC"
        }
      ],
      "answer": {
        "correct_option_id": "B",
        "correct_option_text": "DE ∥ BC",
        "explanation": "4/6=6/9, so use the converse proportionality theorem."
      },
      "marks": null,
      "workspace": {
        "style": "blank",
        "height_mm": 25
      },

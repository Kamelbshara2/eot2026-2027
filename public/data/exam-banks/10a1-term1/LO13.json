      "learning_outcome_id": "LO13",
      "origin": "parallel_practice",
      "stem": "A segment joins the midpoints of two triangle sides. Which statement must be true?",
      "diagram_asset_ids": [],
      "options": [
        {
          "id": "A",
          "text": "It is perpendicular to the third side."
        },
        {
          "id": "B",
          "text": "It is parallel to the third side."
        },
        {
          "id": "C",
          "text": "It equals the third side."
        },
        {
          "id": "D",
          "text": "It bisects the opposite angle."
        }
      ],
      "answer": {
        "correct_option_id": "B",
        "correct_option_text": "It is parallel to the third side.",
        "explanation": "This is the Triangle Midsegment Theorem."

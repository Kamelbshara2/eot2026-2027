      "instruction": "Which option is the complete factorisation of the expression?",
      "stem": "Which option is the complete factorisation of the expression? f g + 4 f - 5 g - 20",
      "math_latex": "f g + 4 f - 5 g - 20",
      "options": [
        {
          "id": "A",
          "text": "\\left(f - 5\\right) \\left(g + 4\\right)",
          "math_latex": "\\left(f - 5\\right) \\left(g + 4\\right)",
          "misconception": null
        },
        {
          "id": "B",
          "text": "\\left(- f - 5\\right) \\left(g + 4\\right)",
          "math_latex": "\\left(- f - 5\\right) \\left(g + 4\\right)",
          "misconception": "Reverse a sign inside a factor."
        },
        {
          "id": "C",
          "text": "\\left(f + 5\\right) \\left(g + 4\\right)",
          "math_latex": "\\left(f + 5\\right) \\left(g + 4\\right)",
          "misconception": "Reverse a sign inside a factor."
        },
        {
          "id": "D",
          "text": "\\left(4 - g\\right) \\left(f - 5\\right)",
          "math_latex": "\\left(4 - g\\right) \\left(f - 5\\right)",
          "misconception": "Reverse a sign inside a factor."
        }
      ],
      "marks": null,
      "answer": {
        "correct_option_id": "A",
        "correct_option_text": "\\left(f - 5\\right) \\left(g + 4\\right)",
        "explanation": "Group terms to extract the same binomial factor from both groups."
      },

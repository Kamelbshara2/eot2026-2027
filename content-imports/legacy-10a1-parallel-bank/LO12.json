      "id": "G10A-Q12-MCQ-01",
      "display_number": "12.1",
      "exam_slot": "Q12",
      "type": "mcq",
      "learning_outcome_id": "LO12",
      "origin": "parallel_practice",
      "stem": "One triangle has angles 42° and 68°. Another has angles 70° and 42°. What can you conclude?",
      "diagram_asset_ids": [],
      "options": [
        {
          "id": "A",
          "text": "The triangles must be congruent."
        },
        {
          "id": "B",
          "text": "Their side lengths must be equal."
        },
        {
          "id": "C",
          "text": "The triangles are similar by AA."
        },
        {
          "id": "D",
          "text": "The triangles cannot be similar."
        }
      ],
      "answer": {
        "correct_option_id": "C",
        "correct_option_text": "The triangles are similar by AA.",
        "explanation": "The first third angle is 70°, so the angle sets match."
      },

     "steps": [
      {
       "text": "Similar polygons: corresponding sides are proportional.",
       "latex": "\\dfrac{a_1}{a_2}=\\dfrac{b_1}{b_2}"
      },
      {
       "text": "Match corresponding sides.",
       "latex": "\\dfrac{8x-1}{3x-1}=\\dfrac{12}{4}=3"
      },
      {
       "text": "Cross-multiply.",
       "latex": "8x-1=9x-3"
      },
      {
       "text": "Solve.",
       "latex": "x=2"

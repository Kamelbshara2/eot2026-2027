  "11G-p18-21a": {
   "parts": {
    "a": {
     "steps": [
      {
       "text": "Similar polygons: corresponding sides are proportional.",
       "latex": "\\dfrac{a_1}{a_2}=\\dfrac{b_1}{b_2}"
      },
      {
       "text": "Match corresponding sides from the figure.",
       "latex": "\\dfrac{x+1}{3x+1}=\\dfrac{8}{20}"
      },
      {
       "text": "Cross-multiply.",
       "latex": "20(x+1)=8(3x+1)\\Rightarrow20x+20=24x+8"
      },
      {
       "text": "Solve.",
       "latex": "4x=12\\Rightarrow x=3"
      }
     ]
    }
   },
   "verified": true
  },
  "11G-p18-21b": {
   "parts": {

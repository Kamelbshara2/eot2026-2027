  "11G-p19-22a": {
   "parts": {
    "a": {
     "steps": [
      {
       "text": "Triangle Proportionality: a line parallel to one side divides the other two sides proportionally.",
       "latex": "\\dfrac{9}{ED}=\\dfrac{6}{4}"
      },
      {
       "text": "Solve.",
       "latex": "6\\,ED=36\\Rightarrow ED=6"
      }
     ]
    }
   },
   "verified": true
  },
  "11G-p19-22b": {
   "parts": {
    "a": {
     "steps": [
      {
       "text": "Parallel line: corresponding parts of the whole triangle are proportional.",
       "latex": "\\dfrac{AE}{AE+5}=\\dfrac{12}{16}"
      },
      {
       "text": "Cross-multiply.",
       "latex": "16AE=12AE+60"
      },
      {
       "text": "Solve.",
       "latex": "4AE=60\\Rightarrow AE=15"
      }
     ]
    }
   },
   "verified": true

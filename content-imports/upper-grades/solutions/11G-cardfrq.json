  "11G-p20-22c": {
   "parts": {
    "a": {
     "steps": [
      {
       "text": "MN = MP − NP.",
       "latex": "MN=18-6=12"
      },
      {
       "text": "Compare the ratios on both sides.",
       "latex": "\\dfrac{MN}{MP}=\\dfrac{12}{18}=\\dfrac23,\\qquad\\dfrac{MR}{MQ}=\\dfrac{16}{24}=\\dfrac23"
      },
      {
       "text": "Equal ratios: by the converse of the Triangle Proportionality Theorem NR ∥ PQ.",
       "latex": "NR\\parallel PQ"
      }
     ]
    }
   },
   "verified": true
  },
  "11G-p20-23a": {
   "parts": {
    "a": {
     "steps": [
      {
       "text": "The leg 5 is opposite the 59° angle: find the other leg with tan and the hypotenuse with sin.",
       "latex": "b=\\dfrac{5}{\\tan59^\\circ},\\quad c=\\dfrac{5}{\\sin59^\\circ}"
      },
      {
       "text": "Evaluate.",
       "latex": "b\\approx3.00,\\quad c\\approx5.83"
      },
      {
       "text": "Perimeter.",
       "latex": "P=5+3.00+5.83\\approx13.84\\ \\text{in}"
      },
      {
       "text": "Area = ½ × leg × leg.",
       "latex": "A=\\tfrac12(5)(3.00)\\approx7.51\\ \\text{in}^2"
      }
     ]
    }
   },
   "verified": true
  },

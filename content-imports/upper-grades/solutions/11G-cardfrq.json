  "11G-p23-25a": {
   "parts": {
    "a": {
     "steps": [
      {
       "text": "Box B: 2% of 150 chips are defective.",
       "latex": "150\\times0.02=3"
      },
      {
       "text": "Without replacement the second draw depends on the first.",
       "latex": "P=\\dfrac{3}{150}\\cdot\\dfrac{2}{149}"
      },
      {
       "text": "Simplify.",
       "latex": "P=\\dfrac{6}{22350}=\\dfrac1{3725}\\approx0.00027"
      }
     ]
    }
   },
   "verified": true
  },
  "11G-p24-25c": {
   "parts": {
    "a": {
     "steps": [
      {
       "text": "Probability of travelling at all.",
       "latex": "P(D\\cup F)=1-0.1=0.9"
      },
      {
       "text": "Addition rule.",
       "latex": "0.9=0.6+P(F)-0.2\\Rightarrow P(F)=0.5"
      },
      {
       "text": "Conditional probability.",
       "latex": "P(F\\mid D)=\\dfrac{P(F\\cap D)}{P(D)}=\\dfrac{0.2}{0.6}=\\dfrac13"
      }
     ]
    }
   },
   "verified": true
  },
  "11G-p24-26a": {
   "parts": {
    "a": {
     "steps": [
      {
       "text": "Not mutually exclusive: subtract the overlap.",
       "latex": "P(A\\cup B)=P(A)+P(B)-P(A\\cap B)"
      },
      {
       "text": "Counts: 5 round, 4 orange, 2 both out of 9.",
       "latex": "\\dfrac59+\\dfrac49-\\dfrac29"
      },
      {
       "text": "Result.",
       "latex": "\\dfrac79"
      }
     ]
    }
   },
   "verified": true
  },
  "11G-p24-26b": {

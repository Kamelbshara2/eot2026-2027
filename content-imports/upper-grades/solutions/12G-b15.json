  "12G-en-Q076": {
   "steps": [
    {
     "text": "The y-intercept is f(0).",
     "latex": "f(0)=2(0)^3-0^2-3(0)=0"
    },
    {
     "text": "Set f(x) = 0 and factor out x.",
     "latex": "2x^3-x^2-3x=x(2x^2-x-3)"
    },
    {
     "text": "Factor the quadratic.",
     "latex": "x(2x-3)(x+1)=0"
    },
    {
     "text": "Zero-product property.",
     "latex": "x=0,\\quad x=\\dfrac32,\\quad x=-1"
    },
    {
     "text": "The graph crosses the x-axis at these three points: option D.",
     "latex": "y\\text{-intercept }0;\\ \\text{zeros }0,\\ 1.5,\\ -1"
    }
   ],
   "verified": true
  },
  "12G-en-Q077": {
   "steps": [
    {
     "text": "The y-intercept is f(0).",
     "latex": "f(0)=0^2-6(0)+9=9"
    },
    {
     "text": "Factor to find the zeros.",
     "latex": "x^2-6x+9=(x-3)^2"
    },
    {
     "text": "One repeated zero (the graph touches the x-axis).",
     "latex": "x=3"
    },
    {
     "text": "Option B.",
     "latex": "y\\text{-intercept }9;\\ \\text{zero }3"
    }
   ],
   "verified": true
  },
  "12G-p30-Ex3-1": {
   "steps": [
    {
     "text": "Relative extrema occur where the slope is zero: f′(x) = 0.",
     "latex": "f\\prime(x)=3x^2-8x-2"
    },
    {
     "text": "Solve with the quadratic formula.",
     "latex": "x=\\dfrac{8\\pm\\sqrt{64+24}}{6}=\\dfrac{4\\pm\\sqrt{22}}{3}"
    },
    {
     "text": "Approximate values.",
     "latex": "x\\approx-0.23\\quad\\text{or}\\quad x\\approx2.90"
    },
    {
     "text": "The cubic has a positive leading coefficient: it rises, has a relative maximum first (smaller x), then a minimum.",
     "latex": "x_{\\max}\\approx-0.2,\\quad x_{\\min}\\approx2.9"
    },
    {
     "text": "Option a).",
     "latex": "x\\approx-0.2"
    }
   ],
   "verified": true
  },
  "12G-p30-Ex2-1": {
   "steps": [
    {
     "text": "Slope is zero at relative extrema.",
     "latex": "f\\prime(x)=3x^2+2x-5=0"
    },
    {
     "text": "Factor.",
     "latex": "(3x+5)(x-1)=0"
    },
    {
     "text": "Critical points.",
     "latex": "x=-\\dfrac53\\approx-1.7\\quad\\text{or}\\quad x=1"
    },
    {
     "text": "Positive leading coefficient: the first (smaller x) critical point is the relative maximum.",
     "latex": "x_{\\max}\\approx-1.7,\\quad x_{\\min}=1"
    },
    {
     "text": "Option a).",
     "latex": "x\\approx-1.7"
    }
   ],
   "verified": true
  },
  "12G-en-Q080": {
   "steps": [
    {
     "text": "A relative maximum is a peak (the graph rises, then falls); a relative minimum is a valley.",
     "latex": "\\text{peak / valley}"
    },
    {
     "text": "Reading the grid: the valley is at x = −2 and the peak at x = 0.",
     "latex": "x_{\\min}=-2,\\quad x_{\\max}=0"
    },
    {
     "text": "Option A.",
     "latex": "\\text{relative max at }x=0,\\ \\text{relative min at }x=-2"
    }
   ],
   "verified": true,
   "note": "read from the graph"
  },
  "12G-en-Q081": {
   "steps": [
    {
     "text": "The marked peak is at x = −2 and the marked valley at x = 1.",
     "latex": "x_{\\max}=-2,\\quad x_{\\min}=1"
    },
    {
     "text": "Option B.",
     "latex": "\\text{relative max at }x=-2,\\ \\text{relative min at }x=1"
    }
   ],
   "verified": true,
   "note": "read from the graph"
  },
  "12G-en-Q082": {
   "steps": [
    {
     "text": "Compare the function values from the table; a relative maximum is where values rise then fall.",
     "latex": "f(-3)=-5,\\ f(-2)=4,\\ f(-1)=3,\\ f(0)=-2"
    },
    {
     "text": "The largest value is 4 at x = −2; the values on both sides are smaller.",
     "latex": "f(-2)=4>f(-3),\\ f(-1)"
    },
    {
     "text": "The relative maximum occurs near x = −2: option A.",
     "latex": "x\\approx-2"
    }
   ],
   "verified": true
  },
  "12G-p31-Ex1-1": {
   "steps": [
    {
     "text": "Divide each term of the numerator by the denominator (subtract exponents of equal bases).",
     "latex": "\\dfrac{6x^4y^3+12x^3y^2-18x^2y}{3xy}"
    },
    {
     "text": "First, second and third term.",
     "latex": "\\dfrac{6x^4y^3}{3xy}=2x^3y^2,\\qquad \\dfrac{12x^3y^2}{3xy}=4x^2y,\\qquad \\dfrac{-18x^2y}{3xy}=-6x"
    },
    {
     "text": "Combine.",
     "latex": "2x^3y^2+4x^2y-6x"
    },
    {
     "text": "Option a).",
     "latex": "2x^3y^2+4x^2y-6x"
    }
   ],
   "verified": true
  },
  "12G-p31-Ex1-2": {
   "steps": [
    {
     "text": "A factor raised to −1 means division: multiply-by-inverse equals dividing by 6ab.",
     "latex": "(24a^4b^3+18a^2b^2-30ab^3)(6ab)^{-1}=\\dfrac{24a^4b^3+18a^2b^2-30ab^3}{6ab}"
    },
    {
     "text": "First, second and third term.",
     "latex": "\\dfrac{24a^4b^3}{6ab}=4a^3b^2,\\qquad \\dfrac{18a^2b^2}{6ab}=3ab,\\qquad \\dfrac{-30ab^3}{6ab}=-5b^2"
    },
    {
     "text": "Combine.",
     "latex": "4a^3b^2+3ab-5b^2"
    },
    {
     "text": "Option a).",
     "latex": "4a^3b^2+3ab-5b^2"
    }
   ],
   "verified": true
  },
  "12G-en-Q084": {
   "steps": [
    {
     "text": "Divide each term of the numerator by the denominator (subtract exponents of equal bases).",
     "latex": "\\dfrac{24a^4b^3+18a^2b^2-30ab^3}{6ab}"
    },
    {
     "text": "First, second and third term.",
     "latex": "\\dfrac{24a^4b^3}{6ab}=4a^3b^2,\\qquad \\dfrac{18a^2b^2}{6ab}=3ab,\\qquad \\dfrac{-30ab^3}{6ab}=-5b^2"
    },
    {
     "text": "Combine.",
     "latex": "4a^3b^2+3ab-5b^2"
    },
    {
     "text": "Option C.",
     "latex": "4a^3b^2+3ab-5b^2"
    }
   ],
   "verified": true
  },
  "12G-en-Q085": {
   "steps": [
    {
     "text": "Divide each term of the numerator by the denominator (subtract exponents of equal bases).",
     "latex": "\\dfrac{9x^9y^5+21x^4y^4-12x^3y^2}{3x^2y^2}"
    },
    {
     "text": "First, second and third term.",
     "latex": "\\dfrac{9x^9y^5}{3x^2y^2}=3x^7y^3,\\qquad \\dfrac{21x^4y^4}{3x^2y^2}=7x^2y^2,\\qquad \\dfrac{-12x^3y^2}{3x^2y^2}=-4x"
    },
    {
     "text": "Combine.",
     "latex": "3x^7y^3+7x^2y^2-4x"
    },
    {
     "text": "Option A.",
     "latex": "3x^7y^3+7x^2y^2-4x"
    }
   ],
   "verified": true
  }
 }

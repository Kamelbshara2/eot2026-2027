  "12G-en-Q045": {
   "steps": [
    {
     "text": "Identify the coefficients.",
     "latex": "a=1,\\ b=-11,\\ c=-26"
    },
    {
     "text": "The discriminant is D = b² − 4ac.",
     "latex": "D=(-11)^2-4(1)(-26)"
    },
    {
     "text": "Simplify.",
     "latex": "D=121+104=225"
    },
    {
     "text": "D > 0: two real roots; D = 0: one repeated real root; D < 0: no real roots.",
     "latex": "\\text{two real solutions}"
    },
    {
     "text": "Option A.",
     "latex": "\\text{two real solutions}"
    }

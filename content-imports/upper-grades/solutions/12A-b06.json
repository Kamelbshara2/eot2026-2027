  "12A-p47-Ex8.2-1": {
   "steps": [
    {
     "text": "Differentiate both sides with respect to x (product rule on x²y²; y′ for every y).",
     "latex": "2xy^2+2x^2y\\,y\\prime-2=-4y\\prime"
    },
    {
     "text": "Collect the y′ terms.",
     "latex": "y\\prime(2x^2y+4)=2-2xy^2"
    },
    {
     "text": "Solve.",
     "latex": "y\\prime=\\dfrac{1-xy^2}{x^2y+2}"
    },
    {
     "text": "Slope at (2, −2).",
     "latex": "y\\prime=\\dfrac{1-2(4)}{4(-2)+2}=\\dfrac{-7}{-6}=\\dfrac76"
    },
    {
     "text": "Tangent line.",
     "latex": "y+2=\\tfrac76(x-2)\\Rightarrow y=\\tfrac76x-\\tfrac{13}{3}"
    },
    {
     "text": "Option B).",
     "latex": "y\\prime=\\dfrac{1-xy^2}{x^2y+2},\\ y=\\tfrac76x-\\tfrac{13}3"
    }
   ],
   "verified": true
  },

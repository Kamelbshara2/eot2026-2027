  "12A-p35-Q32-1": {
   "steps": [
    {
     "text": "Chain Rule.",
     "latex": "h\\prime(2)=f\\prime(g(2))\\cdot g\\prime(2)"
    },
    {
     "text": "g(2) = 3.",
     "latex": "h\\prime(2)=f\\prime(3)\\cdot g\\prime(2)"
    },
    {
     "text": "Substitute.",
     "latex": "(-3)(4)=-12"
    },
    {
     "text": "Option C.",
     "latex": "-12"
    }
   ],
   "verified": true
  },
  "12A-p35-Q33-1": {
   "steps": [
    {
     "text": "Even: f(−x) = f(x). Differentiate with the Chain Rule.",
     "latex": "-f\\prime(-x)=f\\prime(x)\\Rightarrow f\\prime\\ \\text{odd}"
    },
    {
     "text": "Odd: f(−x) = −f(x). Differentiate.",
     "latex": "-f\\prime(-x)=-f\\prime(x)\\Rightarrow f\\prime\\ \\text{even}"
    },
    {
     "text": "Option D.",
     "latex": "\\text{even}\\to\\text{odd},\\ \\text{odd}\\to\\text{even}"
    }
   ],
   "verified": true
  },

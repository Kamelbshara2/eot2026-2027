  "12A-p04-Q23-1": {
   "steps": [
    {
     "text": "Find both one-sided limits at x = −1.",
     "latex": "x\\to-1"
    },
    {
     "text": "Left: 2x + 1.",
     "latex": "\\lim_{x\\to-1^-}(2x+1)=-1"
    },
    {
     "text": "Right: the constant 3.",
     "latex": "\\lim_{x\\to-1^+}3=3"
    },
    {
     "text": "−1 ≠ 3, so the two-sided limit does not exist.",
     "latex": "\\text{does not exist}"
    },
    {
     "text": "Option D.",
     "latex": "\\text{DNE}"
    }
   ],
   "verified": true
  },
  "12A-Q02-added-01": {
   "steps": [
    {
     "text": "0/0: factor the difference of squares.",
     "latex": "\\dfrac{(x-3)(x+3)}{x-3}=x+3"
    },
    {
     "text": "Substitute x = 3.",
     "latex": "3+3=6"
    },
    {
     "text": "Option C.",
     "latex": "6"
    }
   ],
   "verified": true
  },
  "12A-Q03-added-01": {
   "steps": [
    {
     "text": "Bound sin(1/x).",

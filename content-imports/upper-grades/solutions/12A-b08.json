    {
     "text": "Term by term.",
     "latex": "3\\pi t^{\\pi-1}-2(1.3)t^{0.3}=3\\pi t^{\\pi-1}-2.6t^{0.3}"
    },
    {
     "text": "Option A.",
     "latex": "- \\frac{13 t^{\\frac{3}{10}}}{5} + 3 \\pi t^{-1 + \\pi}"
    }
   ],
   "verified": true
  },
  "12A-p29-Q12-1": {
   "steps": [
    {
     "text": "Divide each term by x^(1/2).",
     "latex": "f(x)=4x^{3/2}-x^{1/2}+3x^{-1/2}"
    },
    {
     "text": "Power Rule.",
     "latex": "f\\prime(x)=6x^{1/2}-\\tfrac12x^{-1/2}-\\tfrac32x^{-3/2}"

  "12G-p05-Q4-1": {
   "steps": [
    {
     "text": "Axis of symmetry: x = −b/(2a) with a = 7, b = −28.",
     "latex": "x=-\\dfrac{-28}{2(7)}=2"
    },
    {
     "text": "Substitute x = 2 to find the y-coordinate.",
     "latex": "y=7(2)^2-28(2)+14=28-56+14"
    },
    {
     "text": "Simplify.",
     "latex": "y=-14"
    },
    {
     "text": "The vertex is (2, −14): option b).",
     "latex": "(2,-14)"
    }
   ],
   "verified": true
  },
  "12G-p05-Q5-1": {
   "steps": [
    {
     "text": "Use x = −b/(2a) with a = 4 and b = −8.",
     "latex": "x=-\\dfrac{-8}{2(4)}"
    },
    {
     "text": "Simplify. The axis of symmetry is a vertical line, so it has the form x = k.",
     "latex": "x=\\dfrac{8}{8}=1"
    },
    {
     "text": "Option c): x = 1.",
     "latex": "x=1"
    }
   ],
   "verified": true

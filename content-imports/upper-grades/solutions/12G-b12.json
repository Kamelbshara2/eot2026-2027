  "12G-en-Q056": {
   "steps": [
    {
     "text": "The boundary is a solid parabola that opens upward (vertex near (2, −10), y-intercept −6).",
     "latex": "y=x^2-4x-6"
    },
    {
     "text": "A solid line means the inequality includes the curve: ≥ or ≤.",
     "latex": "\\ge\\ \\text{or}\\ \\le"
    },
    {
     "text": "The shaded region lies above the curve: y ≥ curve.",
     "latex": "y\\ge x^2-4x-6"
    },
    {
     "text": "Option B.",
     "latex": "y\\ge x^2-4x-6"
    }
   ],
   "verified": true,
   "note": "read from the graph"
  },
  "12G-en-Q057": {
   "steps": [
    {
     "text": "Use the labelled points (0, 6), (1, 7), (2, 6): the vertex is (1, 7) and the parabola opens downward.",
     "latex": "y=a(x-1)^2+7"
    },
    {
     "text": "Substitute (0, 6) to find a.",
     "latex": "6=a(0-1)^2+7\\ \\Rightarrow\\ a=-1"
    },
    {
     "text": "Expand.",
     "latex": "y=-(x-1)^2+7=-x^2+2x+6"
    },
    {
     "text": "The curve is solid and the shaded region is below it, so the inequality is ≤.",
     "latex": "y\\le-x^2+2x+6"
    },
    {
     "text": "This is option A.",
     "latex": "y\\le -x^2+2x+6"
    }
   ],
   "verified": true,
   "note": "Teacher review 2026-11-11: solid boundary, key is A."
  },
  "12G-en-Q058": {
   "steps": [
    {
     "text": "The vertex is (−8, 18) and the parabola opens downward.",
     "latex": "y=a(x+8)^2+18"
    },
    {
     "text": "Use (0, 2) to find a.",
     "latex": "2=a(0+8)^2+18\\ \\Rightarrow\\ 64a=-16\\ \\Rightarrow\\ a=-\\dfrac14"
    },
    {
     "text": "The boundary is dashed (strict inequality) and the shaded region is above the curve.",
     "latex": "y>-\\dfrac14(x+8)^2+18"
    },
    {
     "text": "Option A.",
     "latex": "y>-\\dfrac14(x+8)^2+18"
    }
   ],
   "verified": true,
   "note": "read from the graph"
  },
  "12G-en-Q059": {
   "steps": [
    {
     "text": "Degree = the highest power of x; leading coefficient = the coefficient of that term.",
     "latex": "2x^4-3x^3-4x^2-5x-2"
    },
    {
     "text": "Highest power.",
     "latex": "\\deg=4"
    },
    {
     "text": "Coefficient of the highest-power term.",
     "latex": "\\text{leading coefficient}=2"
    },
    {
     "text": "Option B.",
     "latex": "\\text{degree }4,\\ \\text{leading coefficient }2"
    }
   ],
   "verified": true,
   "note": "key corrected from C to B"
  },
  "12G-en-Q060": {
   "steps": [
    {
     "text": "Write the terms by decreasing power.",
     "latex": "-3x^3+2x^2-2"

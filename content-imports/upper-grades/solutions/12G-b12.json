  "12G-en-Q061": {
   "steps": [
    {
     "text": "Multiply the leading terms of the two factors to get the leading term of the product.",
     "latex": "(2x)(4x^2)=8x^3"
    },
    {
     "text": "Degree 3 (1 + 2) and leading coefficient 2 × 4 = 8.",
     "latex": "\\deg=3,\\quad \\text{leading coefficient}=8"
    },
    {
     "text": "Check by expanding.",
     "latex": "(2x-1)(4x^2+3)=8x^3-4x^2+6x-3"
    },
    {
     "text": "Option A.",
     "latex": "\\text{degree }3,\\ \\text{leading coefficient }8"
    }
   ],
   "verified": true
  },

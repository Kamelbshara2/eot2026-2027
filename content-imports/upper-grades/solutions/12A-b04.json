  "12A-p32-Q22c-1": {
   "steps": [
    {
     "text": "h(1) = f(1)/g(1) and h′(1) from the Quotient Rule.",
     "latex": "h(1)=\\dfrac{-2}{1}=-2,\\quad h\\prime(1)=-1"
    },
    {
     "text": "Tangent line at x = a.",
     "latex": "y-h(a)=h\\prime(a)(x-a)"
    },
    {
     "text": "Substitute.",
     "latex": "y+2=-(x-1)\\Rightarrow y=-x-1"
    },
    {
     "text": "Option A).",
     "latex": "y=-x-1"
    }
   ],
   "verified": true
  },

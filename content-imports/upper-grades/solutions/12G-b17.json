  "12G-en-Q095": {
   "steps": [
    {
     "text": "Write the dividend in descending powers (0 for any missing power).",
     "latex": "\\left(3 x^{3} - 8 x^{2} + 11 x - 14\\right)\\div\\left(x - 2\\right)"
    },
    {
     "text": "Synthetic division with the zero of the divisor, x = 2: bring down, multiply by 2, add.",
     "latex": "2\\ \\big|\\ 3\\ \\ -8\\ \\ 11\\ \\ -14\\ \\Rightarrow\\ 3\\ \\ -2\\ \\ 7\\ \\ 0"
    },
    {
     "text": "Quotient and remainder.",
     "latex": "q=3 x^{2} - 2 x + 7,\\qquad r=0"
    },
    {
     "text": "Check: divisor × quotient + remainder = dividend.",
     "latex": "\\left(x - 2\\right)\\left(3 x^{2} - 2 x + 7\\right)+0=3 x^{3} - 8 x^{2} + 11 x - 14"
    },
    {
     "text": "Option A.",
     "latex": "3 x^{2} - 2 x + 7"
    }
   ],
   "verified": true
  },
  "12G-en-Q096": {
   "steps": [
    {
     "text": "Write the dividend in descending powers (0 for any missing power).",
     "latex": "\\left(6 b^{3} - 8 b^{2} + 12 b - 14\\right)\\div\\left(b - 2\\right)"
    },
    {
     "text": "Synthetic division with the zero of the divisor, b = 2: bring down, multiply by 2, add.",
     "latex": "2\\ \\big|\\ 6\\ \\ -8\\ \\ 12\\ \\ -14\\ \\Rightarrow\\ 6\\ \\ 4\\ \\ 20\\ \\ 26"
    },
    {
     "text": "Quotient and remainder.",
     "latex": "q=6 b^{2} + 4 b + 20,\\qquad r=26"
    },
    {
     "text": "Check: divisor × quotient + remainder = dividend.",
     "latex": "\\left(b - 2\\right)\\left(6 b^{2} + 4 b + 20\\right)+26=6 b^{3} - 8 b^{2} + 12 b - 14"
    },
    {
     "text": "Option A.",
     "latex": "6 b^{2} + 4 b + 20+\\dfrac{26}{b-2}"
    }
   ],
   "verified": true
  },

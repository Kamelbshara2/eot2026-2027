    {
     "text": "Factor.",
     "latex": "(2x-1)(x-2)=0"
    },
    {
     "text": "Zero-product property: set each factor equal to 0.",
     "latex": "x=\\dfrac12\\ \\text{or}\\ x=2"
    },
    {
     "text": "Option a).",
     "latex": "x=\\dfrac12\\ \\text{or}\\ x=2"

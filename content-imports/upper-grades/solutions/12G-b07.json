  "12G-en-Q027": {
   "steps": [
    {
     "text": "Collect all terms on the left.",
     "latex": "16y^2-22y+23-26y+13=0\\ \\Rightarrow\\ 16y^2-48y+36=0"
    },
    {
     "text": "Divide by 4.",
     "latex": "4y^2-12y+9=0"
    },
    {
     "text": "Perfect-square trinomial.",
     "latex": "(2y-3)^2=0"
    },
    {
     "text": "One repeated solution.",
     "latex": "y=\\dfrac32"
    },

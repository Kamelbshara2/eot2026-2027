  "12A-p18-Q22b-1": {
   "steps": [
    {
     "text": "Instantaneous velocity is the derivative of position.",
     "latex": "v(t)=s\\prime(t)=3 \\cos{\\left(t - 2 \\right)}"
    },
    {
     "text": "Substitute t = 2.",
     "latex": "v(2)=3\\ \\text{ft/s}"

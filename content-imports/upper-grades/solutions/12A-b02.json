  "12A-p18-Q22a-1": {
   "steps": [
    {
     "text": "Average velocity = change in position ÷ change in time.",
     "latex": "v_{avg}=\\dfrac{s(2)-s(0)}{2-0}"
    },
    {
     "text": "Evaluate the positions.",
     "latex": "s(2)=0,\\quad s(0)=- 3 \\sin{\\left(2 \\right)}"
    },
    {
     "text": "Divide.",
     "latex": "v_{avg}=\\frac{3 \\sin{\\left(2 \\right)}}{2}\\approx1.364\\ \\text{ft/s}"

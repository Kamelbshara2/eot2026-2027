  "12G-p17-Ex2-1": {
   "steps": [
    {
     "text": "Identify a, b, c in x² + 4x − 17 = 0.",
     "latex": "a=1,\\quad b=4,\\quad c=-17"
    },
    {
     "text": "The quadratic formula is x = (−b ± √(b² − 4ac)) / (2a).",
     "latex": "x=\\dfrac{-b\\pm\\sqrt{b^2-4ac}}{2a}"
    },
    {
     "text": "Substitute the values without simplifying.",
     "latex": "x=\\dfrac{-4\\pm\\sqrt{4^2-4(1)(-17)}}{2(1)}"
    },
    {
     "text": "This matches option a); in b) the sign of b is wrong, in c) c is +17, in d) b and c are swapped.",
     "latex": "\\text{option a)}"
    }
   ],
   "verified": true
  },
  "12G-en-Q038": {
   "steps": [
    {
     "text": "Identify the coefficients.",
     "latex": "a=1,\\quad b=4,\\quad c=-17"
    },
    {
     "text": "Quadratic formula.",
     "latex": "x=\\dfrac{-b\\pm\\sqrt{b^2-4ac}}{2a}"
    },
    {
     "text": "Substitute.",
     "latex": "x=\\dfrac{-(4)\\pm\\sqrt{(4)^2-4(1)(-17)}}{2(1)}"
    },
    {
     "text": "Simplify under the root (the discriminant).",
     "latex": "b^2-4ac=16+68=84"
    },
    {
     "text": "Simplify: √84 = 2√21, then divide by 2.",
     "latex": "x=\\dfrac{-4\\pm2\\sqrt{21}}{2}"
    },
    {
     "text": "Option A.",
     "latex": "x=-2\\pm\\sqrt{21}"
    }
   ],
   "verified": true
  },
  "12G-en-Q039": {
   "steps": [
    {
     "text": "Standard form.",
     "latex": "3x^2+5x-2=0"
    },
    {
     "text": "a·c = −6; numbers with product −6 and sum 5: 6 and −1.",
     "latex": "3x^2+6x-x-2=0"
    },
    {
     "text": "Group and factor.",
     "latex": "3x(x+2)-1(x+2)=(3x-1)(x+2)=0"
    },
    {
     "text": "Zero-product property.",
     "latex": "x=\\dfrac13\\ \\text{or}\\ x=-2"
    },
    {
     "text": "Option B.",
     "latex": "x=-2,\\ \\dfrac13"
    }
   ],
   "verified": true
  },
  "12G-en-Q040": {
   "steps": [
    {
     "text": "Write the equation in standard form ax² + bx + c = 0.",
     "latex": "8x-1=4x^2\\ \\Rightarrow\\ 4x^2-8x+1=0"
    },
    {
     "text": "Identify the coefficients.",
     "latex": "a=4,\\quad b=-8,\\quad c=1"
    },
    {
     "text": "Quadratic formula.",
     "latex": "x=\\dfrac{-b\\pm\\sqrt{b^2-4ac}}{2a}"
    },
    {
     "text": "Substitute.",
     "latex": "x=\\dfrac{-(-8)\\pm\\sqrt{(-8)^2-4(4)(1)}}{2(4)}"
    },
    {
     "text": "Simplify under the root (the discriminant).",
     "latex": "b^2-4ac=64-16=48"
    },
    {
     "text": "√48 = 4√3, so divide numerator and denominator by 4.",
     "latex": "x=\\dfrac{8\\pm4\\sqrt3}{8}"
    },
    {
     "text": "Option A.",
     "latex": "x=1\\pm\\dfrac{\\sqrt3}{2}"
    }
   ],
   "verified": true
  },
  "12G-en-Q041": {

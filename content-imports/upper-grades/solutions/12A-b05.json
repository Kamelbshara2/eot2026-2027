  "12A-p37-Q36c-1": {
   "steps": [
    {
     "text": "Chain Rule.",
     "latex": "\\dfrac{d}{dx}f(u(x))=f\\prime(u(x))\\,u\\prime(x)"
    },
    {
     "text": "Inner x·f(x) needs the Product Rule.",
     "latex": "\\dfrac{d}{dx}[xf(x)]=f(x)+xf\\prime(x)"
    },
    {
     "text": "Combine.",
     "latex": "\\dfrac{d}{dx}f(xf(x))=f\\prime(xf(x))\\,(f(x)+xf\\prime(x))"
    },
    {
     "text": "Option D).",
     "latex": "f\\prime(xf(x))(f(x)+xf\\prime(x))"
    }
   ],
   "verified": true
  },
  "12A-p38-Q17-1": {
   "steps": [
    {
     "text": "Inverse-function derivative: if g = f⁻¹ and f(a) = b, then g′(b) = 1 / f′(a).",
     "latex": "g\\prime(b)=\\dfrac1{f\\prime(a)}"
    },
    {
     "text": "Find a with f(a) = -1 (try small integers).",
     "latex": "f(0)=-1\\ \\Rightarrow\\ a=0"
    },
    {
     "text": "Differentiate f.",
     "latex": "f\\prime(x)=3 x^{2} + 4"
    },
    {
     "text": "Evaluate at a = 0.",
     "latex": "f\\prime(0)=4"
    },
    {
     "text": "Reciprocal.",
     "latex": "g\\prime(-1)=\\frac{1}{4}"
    },
    {
     "text": "Option B).",
     "latex": "\\frac{1}{4}"
    }
   ],
   "verified": true
  },

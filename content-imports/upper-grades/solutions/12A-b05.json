  "12A-p36-Q35c-1": {
   "steps": [
    {
     "text": "Chain Rule.",
     "latex": "\\dfrac{d}{dx}f(u(x))=f\\prime(u(x))\\,u\\prime(x)"
    },
    {
     "text": "Outer f, inner f(x).",
     "latex": "\\dfrac{d}{dx}f(f(x))=f\\prime(f(x))\\,f\\prime(x)"

  "12A-p37-Q36a-1": {
   "steps": [
    {
     "text": "Chain Rule.",
     "latex": "\\dfrac{d}{dx}f(u(x))=f\\prime(u(x))\\,u\\prime(x)"
    },
    {
     "text": "Inner √x has derivative 1/(2√x).",
     "latex": "\\dfrac{d}{dx}f(\\sqrt x)=f\\prime(\\sqrt x)\\cdot\\dfrac1{2\\sqrt x}"
    },
    {
     "text": "Option D).",
     "latex": "\\dfrac{f\\prime(\\sqrt x)}{2\\sqrt x}"
    }
   ],
   "verified": true
  },
  "12A-p37-Q36b-1": {
   "steps": [
    {
     "text": "Chain Rule.",
     "latex": "\\dfrac{d}{dx}f(u(x))=f\\prime(u(x))\\,u\\prime(x)"
    },
    {
     "text": "Outer √u has derivative 1/(2√u); inner f(x).",
     "latex": "\\dfrac{d}{dx}\\sqrt{f(x)}=\\dfrac{f\\prime(x)}{2\\sqrt{f(x)}}"
    },
    {
     "text": "Option A).",
     "latex": "\\dfrac{f\\prime(x)}{2\\sqrt{f(x)}}"

  "12A-p34-Q24c-1": {
   "steps": [
    {
     "text": "Quotient Rule for x²/g(x).",
     "latex": "h\\prime(x)=\\dfrac{2x\\,g(x)-x^2g\\prime(x)}{g(x)^2}"
    },
    {
     "text": "At x = 1 (g(1) = 1, g′(1) = −2).",
     "latex": "h(1)=\\dfrac{1}{1}=1,\\quad h\\prime(1)=\\dfrac{2(1)(1)-(1)(-2)}{1^2}=4"
    },
    {
     "text": "Tangent line.",
     "latex": "y-1=4(x-1)\\Rightarrow y=4x-3"
    },
    {
     "text": "Option A).",
     "latex": "y=4x-3"
    }
   ],
   "verified": true
  },
  "12A-p34-Q31-1": {
   "steps": [
    {
     "text": "Chain Rule.",
     "latex": "\\dfrac{d}{dx}f(u(x))=f\\prime(u(x))\\,u\\prime(x)"
    },
    {
     "text": "h′(1) = f′(g(1))·g′(1) with g(1) = 2.",
     "latex": "h\\prime(1)=f\\prime(2)\\cdot g\\prime(1)"
    },
    {
     "text": "Substitute f′(2) = 3, g′(1) = −2.",
     "latex": "h\\prime(1)=3(-2)=-6"
    },
    {
     "text": "Option B).",
     "latex": "-6"
    }
   ],
   "verified": true
  },
  "12A-p35-Q34-1": {
   "steps": [
    {
     "text": "Symmetry about x = a means f(a + h) = f(a − h).",
     "latex": "f(a+h)=f(a-h)"
    },
    {
     "text": "Differentiate with respect to h.",
     "latex": "f\\prime(a+h)=-f\\prime(a-h)"
    },
    {
     "text": "So f′ is symmetric about the point (a, 0) (point symmetry).",
     "latex": "(a,\\ 0)"
    },
    {
     "text": "Option A).",
     "latex": "(a,0)"
    }
   ],
   "verified": true
  },
  "12A-p36-Q35a-1": {
   "steps": [
    {
     "text": "Chain Rule.",
     "latex": "\\dfrac{d}{dx}f(u(x))=f\\prime(u(x))\\,u\\prime(x)"
    },
    {
     "text": "Outer f, inner x³ with derivative 3x².",
     "latex": "\\dfrac{d}{dx}f(x^3)=f\\prime(x^3)\\cdot3x^2"
    },
    {
     "text": "Option A).",
     "latex": "3f\\prime(x^3)\\,x^2"
    }
   ],
   "verified": true
  },
  "12A-p36-Q35b-1": {
   "steps": [
    {
     "text": "Chain Rule.",
     "latex": "\\dfrac{d}{dx}f(u(x))=f\\prime(u(x))\\,u\\prime(x)"
    },
    {
     "text": "Outer u², inner f(x).",
     "latex": "\\dfrac{d}{dx}[f(x)]^2=2f(x)\\,f\\prime(x)"
